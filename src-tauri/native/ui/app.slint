import { SettingsWindow, SettingsData, ThemeSwatch, LangOption, UsageSeg, AccentPreset } from "settings.slint";

export { Theme, I18n, PopupWindow, Layout, CardData, RowData, TabData, MenuEntry, FilterEntry }
export { SettingsWindow, SettingsData, ThemeSwatch, LangOption, UsageSeg, AccentPreset }
